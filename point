#!/usr/bin/env node
// point FILE LINES ["note1|note2"]   highlight lines, e.g. point app/x.rb 84,120-125 "first|second"
// point board SPEC.json | -          apply a whiteboard spec (see README), "-" reads stdin
// point diff FILE [REF] [LINES] ["notes"]  side-by-side diff against a git ref (default HEAD), marks on the new side
// point --clear                      remove every mark
const fs = require('fs');
const os = require('os');
const path = require('path');

const dir = path.join(os.homedir(), '.pointer');
const send = (board) => {
  fs.mkdirSync(dir, { recursive: true });
  if (board.file) board.file = path.resolve(board.file);
  board.id = `${Date.now()}-${process.pid}`;
  const tmp = path.join(dir, `.board-${process.pid}.tmp`);
  fs.writeFileSync(tmp, JSON.stringify(board));
  fs.renameSync(tmp, path.join(dir, 'board.json'));
};

const [a, b, c, d, e] = process.argv.slice(2);
if (!a || a === '-h' || a === '--help') {
  console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(1, 5).map((l) => l.slice(3)).join('\n'));
} else if (a === '--clear') {
  send({ clear: 'all' });
} else if (a === 'diff') {
  send({ file: b, diff: c || 'HEAD', reveal: d ? String(d).split(',')[0] : undefined, ops: d ? [{ op: 'highlight', lines: d, note: e }] : [] });
} else if (a === 'board') {
  send(JSON.parse(fs.readFileSync(b === '-' || !b ? 0 : b, 'utf8')));
} else {
  const extra = Object.fromEntries(new URLSearchParams(process.env.POINTER_EXTRA || ''));
  send({ file: a, reveal: String(b).split(',')[0], ...extra, add: extra.add === '1', ops: [{ op: 'highlight', lines: b, note: c }] });
}
